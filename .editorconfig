root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

[*.cs]
csharp_space_after_keywords_in_control_flow_statements = false
csharp_space_around_declaration_statements = true
csharp_space_between_parentheses = true
